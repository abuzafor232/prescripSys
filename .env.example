NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bd_prescription?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=bd-prescription-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMS gateway abstraction
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=

# Medicine import
MEDICINE_IMPORT_PATH=/path/to/medicine_information_export.csv
