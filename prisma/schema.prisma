generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum AppointmentStatus {
  WAITING
  CONFIRMED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  EXPORT
  IMPORT
  VERIFY
}

enum BillingStatus {
  UNPAID
  PAID
  PARTIAL
  WAIVED
  REFUNDED
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(TRIAL)
  plan        String       @default("starter")
  locale      String       @default("en-BD")
  timezone    String       @default("Asia/Dhaka")
  settings    Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users           User[]
  roles           Role[]
  permissions     Permission[]
  doctors         Doctor[]
  chambers        Chamber[]
  patients        Patient[]
  prescriptions   Prescription[]
  medicines       Medicine[]
  appointments    Appointment[]
  investigations  Investigation[]
  diagnoses       Diagnosis[]
  auditLogs       AuditLog[]
  settingsRecords Setting[]
  invoices        Invoice[]

  @@map("tenants")
}

model User {
  id                  String     @id @default(cuid())
  tenantId            String
  email               String
  phone               String?
  passwordHash        String
  fullName            String
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles            UserRole[]
  sessions         Session[]
  doctor           Doctor?
  assistantProfile AssistantProfile?
  auditLogs        AuditLog[]       @relation("AuditActor")
  createdPatients  Patient[]        @relation("PatientCreatedBy")
  createdPrescriptions Prescription[] @relation("PrescriptionCreatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  RolePermission[]

  @@unique([tenantId, name])
  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Doctor {
  id                      String   @id @default(cuid())
  tenantId                String
  userId                  String   @unique
  displayName             String
  bmdcNumber              String?
  specialization          String?
  designation             String?
  qualifications          String?
  profileImageUrl         String?
  signatureUrl            String?
  defaultTemplateId       String?
  prescriptionPreferences Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chambers      DoctorChamber[]
  prescriptions Prescription[]
  appointments  Appointment[]
  favorites            DoctorFavoriteMedicine[]
  templates            DosageTemplate[]
  prescriptionGroups   PrescriptionGroup[]

  @@unique([tenantId, bmdcNumber])
  @@index([tenantId, displayName])
  @@map("doctors")
}

model AssistantProfile {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  chambers ChamberAssistant[]

  @@index([tenantId])
  @@map("assistant_profiles")
}

model Chamber {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  address            String
  phone              String?
  email              String?
  logoUrl            String?
  header             Json     @default("{}")
  timings            Json     @default("[]")
  serialPrefix       String   @default("")
  dailySerialReset   Boolean  @default(true)
  prescriptionFooter String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctors       DoctorChamber[]
  assistants    ChamberAssistant[]
  patients      Patient[]
  prescriptions Prescription[]
  appointments  Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("chambers")
}

model DoctorChamber {
  doctorId  String
  chamberId String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@id([doctorId, chamberId])
  @@map("doctor_chambers")
}

model ChamberAssistant {
  chamberId   String
  assistantId String
  createdAt   DateTime @default(now())

  chamber   Chamber          @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  assistant AssistantProfile @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@id([chamberId, assistantId])
  @@map("chamber_assistants")
}

model Patient {
  id                    String   @id @default(cuid())
  tenantId              String
  chamberId             String?
  createdByUserId       String?
  registrationNo        String?
  name                  String
  phone                 String?
  gender                Gender   @default(UNKNOWN)
  dateOfBirth           DateTime?
  ageYears              Int?
  ageMonths             Int?
  ageDays               Int?
  bloodGroup            String?
  address               String?
  allergies             String?
  chronicDiseaseHistory String?
  emergencyContact      String?
  searchText            String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chamber       Chamber?       @relation(fields: [chamberId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("PatientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]
  appointments  Appointment[]
  vitals        PatientVital[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@index([tenantId, searchText])
  @@map("patients")
}

model PatientVital {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  weightKg    Decimal? @db.Decimal(6, 2)
  heightCm    Decimal? @db.Decimal(6, 2)
  bpSystolic  Int?
  bpDiastolic Int?
  pulse       Int?
  temperature Decimal? @db.Decimal(5, 2)
  spo2        Int?
  notes       String?
  recordedAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, recordedAt])
  @@map("patient_vitals")
}

model Medicine {
  id                  String   @id @default(cuid())
  tenantId            String?
  brandName           String
  genericName         String
  companyName         String?
  strength            String?
  dosageForm          String?
  price               Decimal? @db.Decimal(10, 2)
  category            String?
  darNo               String?
  globalKey           String?  @unique
  tenantKey           String?
  source              String   @default("manual")
  normalizedBrand     String
  normalizedGeneric   String
  normalizedCompany   String?
  banglaName          String?
  searchText          String
  isActive            Boolean  @default(true)
  importedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant       Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]
  favorites    DoctorFavoriteMedicine[]

  @@unique([tenantId, brandName, genericName, dosageForm, strength, companyName])
  @@unique([tenantId, tenantKey])
  @@index([tenantId, isActive])
  @@index([normalizedBrand])
  @@index([normalizedGeneric])
  @@index([searchText])
  @@map("medicines")
}

model DoctorFavoriteMedicine {
  doctorId   String
  medicineId String
  note       String?
  createdAt  DateTime @default(now())

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([doctorId, medicineId])
  @@map("doctor_favorite_medicines")
}

model DosageTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  doctorId    String?
  name        String
  dose        String
  duration    String?
  instruction String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, name])
  @@index([tenantId, doctorId])
  @@map("dosage_templates")
}

model Prescription {
  id                 String             @id @default(cuid())
  tenantId           String
  patientId          String
  doctorId           String
  chamberId          String
  createdByUserId    String?
  appointmentId      String?            @unique
  prescriptionNo     String
  status             PrescriptionStatus @default(DRAFT)
  chiefComplaints    String?
  examination        String?
  advice             String?
  followUpDate       DateTime?
  qrToken            String             @unique
  signedAt           DateTime?
  printedAt          DateTime?
  cancelledAt        DateTime?
  currentVersion     Int                @default(1)
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient         Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor          Doctor                    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  chamber         Chamber                   @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  createdBy       User?                     @relation("PrescriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointment     Appointment?              @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  medicines       PrescriptionItem[]
  investigations  PrescriptionInvestigation[]
  diagnoses       PrescriptionDiagnosis[]
  versions        PrescriptionVersion[]

  @@unique([tenantId, prescriptionNo])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, doctorId, createdAt])
  @@index([tenantId, chamberId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  tenantId       String
  prescriptionId String
  medicineId     String?
  brandName      String
  genericName    String?
  strength       String?
  dosageForm     String?
  dose           String
  duration       String
  instruction    String?
  note           String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([tenantId, prescriptionId, sortOrder])
  @@index([tenantId, medicineId])
  @@map("prescription_items")
}

model Investigation {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  category   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions PrescriptionInvestigation[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("investigations")
}

model PrescriptionInvestigation {
  id              String   @id @default(cuid())
  tenantId        String
  prescriptionId  String
  investigationId String?
  name            String
  note            String?
  sortOrder       Int      @default(0)

  prescription  Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  investigation Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  @@index([tenantId, prescriptionId, sortOrder])
  @@map("prescription_investigations")
}

model Diagnosis {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  icdCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions PrescriptionDiagnosis[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("diagnoses")
}

model PrescriptionDiagnosis {
  id             String @id @default(cuid())
  tenantId       String
  prescriptionId String
  diagnosisId    String?
  name           String
  note           String?
  sortOrder      Int    @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis?   @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@index([tenantId, prescriptionId, sortOrder])
  @@map("prescription_diagnoses")
}

model PrescriptionVersion {
  id             String   @id @default(cuid())
  tenantId       String
  prescriptionId String
  version        Int
  snapshot       Json
  changedById    String?
  changeReason   String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@unique([prescriptionId, version])
  @@index([tenantId, prescriptionId])
  @@map("prescription_versions")
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  chamberId      String
  doctorId       String
  patientId      String?
  serialNo       Int
  token          String
  scheduledAt    DateTime
  status         AppointmentStatus @default(WAITING)
  reason         String?
  notes          String?
  fee            Decimal?          @db.Decimal(10, 2)
  billingStatus  BillingStatus     @default(UNPAID)
  checkedInAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chamber      Chamber       @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  prescription Prescription?

  @@unique([tenantId, chamberId, scheduledAt, serialNo])
  @@index([tenantId, doctorId, scheduledAt])
  @@index([tenantId, chamberId, scheduledAt, status])
  @@map("appointments")
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceNo     String
  amount        Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status        BillingStatus @default(UNPAID)
  description   String?
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, status])
  @@map("invoices")
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  channel     String
  recipient   String
  subject     String?
  body        String
  status      String   @default("queued")
  provider    String?
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String      @id @default(cuid())
  tenantId     String
  actorUserId  String?
  action       AuditAction
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@map("settings")
}

model PrescriptionGroup {
  id          String   @id @default(cuid())
  tenantId    String
  doctorId    String
  sectionType String
  name        String
  items       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctorId, sectionType, name])
  @@index([tenantId, doctorId, sectionType])
  @@map("prescription_groups")
}
