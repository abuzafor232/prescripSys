{
  "name": "bd-prescription-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-based Doctor Prescription and Chamber Management SaaS platform for Bangladesh.",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @bd-prescription/web dev",
    "dev:api": "pnpm --filter @bd-prescription/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css,prisma}\"",
    "prisma:generate": "pnpm --filter @bd-prescription/api prisma:generate",
    "prisma:migrate": "pnpm --filter @bd-prescription/api prisma:migrate",
    "db:seed": "pnpm --filter @bd-prescription/api db:seed",
    "medicine:import": "pnpm --filter @bd-prescription/api medicine:import"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
